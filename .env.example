# Geliştirme ortamı için örnek ortam değişkenleri.
# Kullanım: Bu dosyayı kopyalayarak .env adıyla kaydedin.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env  (Windows CMD)
#
# NOT: .env dosyası .gitignore tarafından dışlanmıştır.
# Gerçek credentials'ları asla commit etmeyin.

# PostgreSQL şifreleri
POSTGRES_USER_PASSWORD=postgres
POSTGRES_CONTENT_PASSWORD=postgres

# RabbitMQ kimlik bilgileri
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
