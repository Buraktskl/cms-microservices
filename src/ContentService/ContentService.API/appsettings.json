{
  "ConnectionStrings": {
    "ContentDb": "Host=postgres-content;Port=5432;Database=content_db;Username=postgres;Password=${POSTGRES_CONTENT_PASSWORD}",
    "RabbitMq": "amqp://guest:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/",
    "Redis": "redis:6379"
  },
  "UserService": {
    "BaseUrl": "http://user-service:5002"
  },
  "Elasticsearch": {
    "Uri": "http://elasticsearch:9200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
