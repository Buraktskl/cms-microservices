{
  "ConnectionStrings": {
    "UserDb": "Host=postgres-user;Port=5432;Database=user_db;Username=postgres;Password=${POSTGRES_USER_PASSWORD}",
    "RabbitMq": "amqp://guest:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/",
    "Redis": "redis:6379"
  },
  "Elasticsearch": {
    "Uri": "http://elasticsearch:9200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
